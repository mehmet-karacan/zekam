{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zekam Memory Compiler Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "output_id", "realm_id", "project_id", "work_item_id", "run_id", "source_set", "source_watermark", "parser_digest", "compiler_digest", "policy_digest", "profile_digest", "candidates", "rejected", "duplicate_groups", "conflict_groups", "gateway_request_ref", "gateway_request_digest", "gateway_response_ref", "gateway_response_digest", "created_at", "direct_promotion", "grants_authority", "output_digest"],
  "properties": {
    "schema": {"const": "zekam-memory-compiler-output/v1"}, "output_id": {"$ref": "#/$defs/uuid"}, "realm_id": {"$ref": "#/$defs/uuid"}, "project_id": {"$ref": "#/$defs/uuid"}, "work_item_id": {"$ref": "#/$defs/uuid"}, "run_id": {"$ref": "#/$defs/uuid"},
    "source_set": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/digestRef"}}, "source_watermark": {"$ref": "#/$defs/ref"}, "parser_digest": {"$ref": "#/$defs/digest"}, "compiler_digest": {"$ref": "#/$defs/digest"}, "policy_digest": {"$ref": "#/$defs/digest"}, "profile_digest": {"$ref": "#/$defs/digest"},
    "candidates": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/candidate"}}, "rejected": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/rejection"}}, "duplicate_groups": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/group"}}, "conflict_groups": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/group"}},
    "gateway_request_ref": {"$ref": "#/$defs/nullableRef"}, "gateway_request_digest": {"$ref": "#/$defs/nullableDigest"}, "gateway_response_ref": {"$ref": "#/$defs/nullableRef"}, "gateway_response_digest": {"$ref": "#/$defs/nullableDigest"}, "created_at": {"$ref": "#/$defs/timestamp"}, "direct_promotion": {"const": false}, "grants_authority": {"const": false}, "output_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "nullableDigest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}, "timestamp": {"type": "string", "format": "date-time"}, "ref": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}, "nullableRef": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "truth": {"enum": ["USER_DECISION", "REPO_FACT", "EXTERNAL_VERIFIED_FACT", "MODEL_INFERENCE", "TEMPORARY_ASSUMPTION", "SUPERSEDED", "UNKNOWN"]}, "classification": {"enum": ["public", "internal", "confidential", "restricted", "local-only", "pii", "corporate-confidential", "secret", "raw-transcript", "diagnostic-payload"]},
    "digestRef": {"type": "object", "additionalProperties": false, "required": ["ref", "digest", "truth_class"], "properties": {"ref": {"$ref": "#/$defs/ref"}, "digest": {"$ref": "#/$defs/digest"}, "truth_class": {"$ref": "#/$defs/truth"}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "logical_key", "content_ref", "content_digest", "truth_class", "classification", "candidate_type", "risk", "source_refs", "evidence_refs", "state", "review_required", "direct_promotion", "grants_authority"], "properties": {"candidate_id": {"$ref": "#/$defs/ref"}, "logical_key": {"$ref": "#/$defs/ref"}, "content_ref": {"$ref": "#/$defs/ref"}, "content_digest": {"$ref": "#/$defs/digest"}, "truth_class": {"$ref": "#/$defs/truth"}, "classification": {"$ref": "#/$defs/classification"}, "candidate_type": {"enum": ["durable_decision", "project_fact", "project_convention", "reusable_lesson", "skill_candidate", "failure_pattern", "known_issue", "unresolved_work", "obsolete_knowledge_candidate", "conflict_candidate", "projection_refresh_request"]}, "risk": {"enum": ["low", "medium", "high", "critical"]}, "source_refs": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/digestRef"}}, "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/digestRef"}}, "state": {"const": "candidate"}, "review_required": {"const": true}, "direct_promotion": {"const": false}, "grants_authority": {"const": false}}},
    "rejection": {"type": "object", "additionalProperties": false, "required": ["source_ref", "reason_code", "evidence_digest", "quarantined"], "properties": {"source_ref": {"$ref": "#/$defs/ref"}, "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,95}$"}, "evidence_digest": {"$ref": "#/$defs/digest"}, "quarantined": {"type": "boolean"}}},
    "group": {"type": "object", "additionalProperties": false, "required": ["group_digest", "candidate_ids"], "properties": {"group_digest": {"$ref": "#/$defs/digest"}, "candidate_ids": {"type": "array", "minItems": 2, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}}}
  }
}
