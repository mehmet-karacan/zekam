{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zekam Session Hydration Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_id", "realm_id", "project_id", "work_item_id", "run_id", "session_id", "client_id", "plan_ref", "checkpoint_ref", "source_digest", "policy_digest", "migration_digest", "inventory_digest", "context_digest", "required_selections", "optional_selections", "omissions", "token_budget", "tokens_used", "freshness", "projection_refs", "hydration_event_digest", "created_at", "fresh", "complete", "grants_authority", "receipt_digest"],
  "properties": {
    "schema": {"const": "zekam-session-hydration-receipt/v1"},
    "receipt_id": {"$ref": "#/$defs/uuid"},
    "realm_id": {"$ref": "#/$defs/uuid"},
    "project_id": {"$ref": "#/$defs/uuid"},
    "work_item_id": {"$ref": "#/$defs/uuid"},
    "run_id": {"$ref": "#/$defs/uuid"},
    "session_id": {"$ref": "#/$defs/ref"},
    "client_id": {"$ref": "#/$defs/ref"},
    "plan_ref": {"$ref": "#/$defs/ref"},
    "checkpoint_ref": {"$ref": "#/$defs/ref"},
    "source_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "migration_digest": {"$ref": "#/$defs/digest"},
    "inventory_digest": {"$ref": "#/$defs/digest"},
    "context_digest": {"$ref": "#/$defs/digest"},
    "required_selections": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/selection"}},
    "optional_selections": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/selection"}},
    "omissions": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/omission"}},
    "token_budget": {"type": "integer", "minimum": 1},
    "tokens_used": {"type": "integer", "minimum": 0},
    "freshness": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/freshness"}},
    "projection_refs": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/digestRef"}},
    "hydration_event_digest": {"$ref": "#/$defs/digest"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "fresh": {"type": "boolean"},
    "complete": {"type": "boolean"},
    "grants_authority": {"const": false},
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "ref": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "truth": {"enum": ["USER_DECISION", "REPO_FACT", "EXTERNAL_VERIFIED_FACT", "MODEL_INFERENCE", "TEMPORARY_ASSUMPTION", "SUPERSEDED", "UNKNOWN"]},
    "digestRef": {"type": "object", "additionalProperties": false, "required": ["ref", "digest", "truth_class"], "properties": {"ref": {"$ref": "#/$defs/ref"}, "digest": {"$ref": "#/$defs/digest"}, "truth_class": {"$ref": "#/$defs/truth"}}},
    "selection": {"type": "object", "additionalProperties": false, "required": ["ref", "content_digest", "token_count", "truth_class"], "properties": {"ref": {"$ref": "#/$defs/ref"}, "content_digest": {"$ref": "#/$defs/digest"}, "token_count": {"type": "integer", "minimum": 1}, "truth_class": {"$ref": "#/$defs/truth"}}},
    "omission": {"type": "object", "additionalProperties": false, "required": ["ref", "reason_code", "required"], "properties": {"ref": {"$ref": "#/$defs/ref"}, "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,95}$"}, "required": {"type": "boolean"}}},
    "freshness": {"type": "object", "additionalProperties": false, "required": ["name", "observed_digest", "expected_digest", "current"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,95}$"}, "observed_digest": {"$ref": "#/$defs/digest"}, "expected_digest": {"$ref": "#/$defs/digest"}, "current": {"type": "boolean"}}}
  }
}
