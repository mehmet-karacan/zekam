{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zekam Research Agent Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "research_id",
    "role",
    "execution_identity",
    "status",
    "findings",
    "evidence",
    "contradictions",
    "unknowns",
    "input_digest",
    "result_digest",
    "created_at",
    "grants_authority"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "result_id": {
      "$ref": "#/$defs/id"
    },
    "research_id": {
      "$ref": "#/$defs/id"
    },
    "role": {
      "enum": [
        "researcher",
        "architecture-reviewer",
        "domain-reviewer",
        "critic",
        "counter-evidence-researcher",
        "synthesizer",
        "citation-verifier"
      ]
    },
    "execution_identity": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed",
        "blocked",
        "abstained"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "confidence_bp",
          "evidence_refs"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "maxLength": 5000
          },
          "confidence_bp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidenceRef"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 5000
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 5000
      }
    },
    "input_digest": {
      "$ref": "#/$defs/digest"
    },
    "result_digest": {
      "$ref": "#/$defs/digest"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "grants_authority": {
      "const": false
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "logicalResource": {
      "type": "string",
      "pattern": "^[a-z0-9-]+:[^\\s]+$",
      "maxLength": 500
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
      "maxLength": 1000
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "work",
            "run",
            "receipt",
            "test",
            "artifact",
            "source",
            "citation",
            "memory",
            "benchmark",
            "commit"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}