{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zekam OpenCode Research Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "question_digest",
    "researcher",
    "verification",
    "grants_authority"
  ],
  "properties": {
    "schema": {
      "const": "zekam-opencode-research-result/v1"
    },
    "question_digest": {
      "$ref": "#/$defs/digest"
    },
    "researcher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_ref",
        "outcome",
        "findings",
        "objections",
        "blocker"
      ],
      "properties": {
        "agent_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "outcome": {
          "enum": [
            "success",
            "partial",
            "failed",
            "blocked",
            "abstained",
            "recovery-required"
          ]
        },
        "findings": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "finding_id",
              "claim",
              "confidence",
              "citation_ids"
            ],
            "properties": {
              "finding_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "claim": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "confidence": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "citation_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            }
          }
        },
        "objections": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "blocker": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier_ref",
        "researcher_payload_digest",
        "evidence_manifest_digest",
        "verified_finding_ids",
        "rejected_finding_ids",
        "rejection_reasons"
      ],
      "properties": {
        "verifier_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "researcher_payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "evidence_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "verified_finding_ids": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "rejected_finding_ids": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "rejection_reasons": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "grants_authority": {
      "const": false
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
