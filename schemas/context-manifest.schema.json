{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zekam Context Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "token_budget", "selected", "omitted", "candidate_fingerprint", "created_at", "manifest_digest", "grants_authority"],
  "properties": {
    "schema_version": {"const": 1},
    "token_budget": {"type": "integer", "minimum": 1},
    "selected": {"type": "array", "items": {"type": "object", "required": ["candidate_id", "content_digest", "token_count", "score", "reason"], "additionalProperties": false, "properties": {
      "candidate_id": {"type": "string", "minLength": 1},
      "content_digest": {"$ref": "#/$defs/digest"},
      "token_count": {"type": "integer", "minimum": 1},
      "score": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}, {"type": "string"}], "items": false},
      "reason": {"enum": ["required-first", "authority-freshness-score"]}
    }}},
    "omitted": {"type": "array", "items": {"type": "object", "required": ["candidate_id", "reason"], "additionalProperties": false, "properties": {
      "candidate_id": {"type": "string"},
      "reason": {"enum": ["budget-exhausted", "stale", "insufficient-authority", "superseded"]}
    }}},
    "candidate_fingerprint": {"$ref": "#/$defs/digest"},
    "created_at": {"type": "string", "format": "date-time"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "grants_authority": {"const": false}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
