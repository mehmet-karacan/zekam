{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zekam Continuity Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "project_id",
    "work_item_id",
    "goal",
    "status",
    "current_step",
    "completed",
    "pending",
    "decisions",
    "risks",
    "first_reads",
    "next_safe_actions",
    "authoritative_refs",
    "source_revision",
    "created_at",
    "packet_digest",
    "grants_authority",
    "carries_active_lease",
    "approval_inherited"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "work_item_id": {
      "$ref": "#/$defs/id"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "current_step": {
      "type": "string",
      "maxLength": 2000
    },
    "completed": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "pending": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 3000
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 3000
      }
    },
    "first_reads": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "next_safe_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "authoritative_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "packet_digest": {
      "$ref": "#/$defs/digest"
    },
    "grants_authority": {
      "const": false
    },
    "carries_active_lease": {
      "const": false
    },
    "approval_inherited": {
      "const": false
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "logicalResource": {
      "type": "string",
      "pattern": "^[a-z0-9-]+:[^\\s]+$",
      "maxLength": 500
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
      "maxLength": 1000
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "work",
            "run",
            "receipt",
            "test",
            "artifact",
            "source",
            "citation",
            "memory",
            "benchmark",
            "commit"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
