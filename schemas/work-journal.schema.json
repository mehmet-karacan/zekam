{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zekam Work Journal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_item_id", "entries", "head_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "work_item_id": {"type": "string", "minLength": 1},
    "entries": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["sequence", "event_kind", "payload_digest", "previous_digest", "truncated", "created_at", "entry_digest"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "event_kind": {"type": "string", "minLength": 1},
        "payload_digest": {"$ref": "#/$defs/digest"},
        "previous_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "truncated": {"type": "boolean"},
        "created_at": {"type": "string", "format": "date-time"},
        "entry_digest": {"$ref": "#/$defs/digest"}
      }}},
    "head_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
