{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zekam Task Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "project_id",
    "work_item_id",
    "revision",
    "source_revision",
    "policy_digest",
    "steps",
    "effect_digest",
    "created_at",
    "plan_digest",
    "grants_authority"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "work_item_id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "kind",
          "role",
          "dependencies",
          "read_resources",
          "write_resources",
          "risk",
          "agentic",
          "minimum_subagents",
          "acceptance",
          "timeout_seconds"
        ],
        "properties": {
          "step_id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "read_resources": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/logicalResource"
            }
          },
          "write_resources": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/logicalResource"
            }
          },
          "risk": {
            "enum": [
              "none",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "agentic": {
            "type": "boolean"
          },
          "minimum_subagents": {
            "type": "integer",
            "minimum": 0
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          }
        }
      }
    },
    "effect_digest": {
      "$ref": "#/$defs/digest"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "grants_authority": {
      "const": false
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "logicalResource": {
      "type": "string",
      "pattern": "^[a-z0-9-]+:[^\\s]+$",
      "maxLength": 500
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
      "maxLength": 1000
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "work",
            "run",
            "receipt",
            "test",
            "artifact",
            "source",
            "citation",
            "memory",
            "benchmark",
            "commit"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}