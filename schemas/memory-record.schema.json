{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zekam Memory Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "memory_id",
    "class",
    "scope",
    "subject_keys",
    "status",
    "revision",
    "summary",
    "evidence_refs",
    "source_revisions",
    "valid_from",
    "confidence_bp",
    "created_by",
    "reviewed_by",
    "created_at",
    "record_digest",
    "grants_authority"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "memory_id": {
      "$ref": "#/$defs/id"
    },
    "class": {
      "enum": [
        "working",
        "episodic",
        "semantic",
        "procedural",
        "preference",
        "failure"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "global-user",
            "project",
            "work-item",
            "run",
            "agent"
          ]
        },
        "ref": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "subject_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "status": {
      "enum": [
        "candidate",
        "reviewed",
        "active",
        "superseded",
        "revoked",
        "archived"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "source_revisions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "valid_from": {
      "$ref": "#/$defs/timestamp"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "confidence_bp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "conflicts_with": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "created_by": {
      "$ref": "#/$defs/id"
    },
    "reviewed_by": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "record_digest": {
      "$ref": "#/$defs/digest"
    },
    "grants_authority": {
      "const": false
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "logicalResource": {
      "type": "string",
      "pattern": "^[a-z0-9-]+:[^\\s]+$",
      "maxLength": 500
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
      "maxLength": 1000
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "work",
            "run",
            "receipt",
            "test",
            "artifact",
            "source",
            "citation",
            "memory",
            "benchmark",
            "commit"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}