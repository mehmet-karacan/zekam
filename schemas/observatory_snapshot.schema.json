{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zekam.local/schemas/observatory_snapshot.schema.json",
  "title": "Zekam Canlı Yürütme Gözleme Merkezi Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "projection_digest",
    "read_only",
    "grants_authority",
    "dashboard",
    "graph",
    "agents",
    "events",
    "reports",
    "causal",
    "canonical_runtime",
    "runtime",
    "safety"
  ],
  "properties": {
    "schema": { "const": "zekam-observatory-snapshot/v3" },
    "generated_at": { "type": "string", "format": "date-time" },
    "projection_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "read_only": { "const": true },
    "grants_authority": { "const": false },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "tiles", "read_only", "grants_authority"],
      "properties": {
        "schema": { "const": "zekam-dashboard/v1" },
        "read_only": { "const": true },
        "grants_authority": { "const": false },
        "tiles": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "title", "value", "drill_down", "detail"],
            "properties": {
              "key": { "enum": ["work", "run", "model", "knowledge", "memory", "scheduler"] },
              "title": { "type": "string", "minLength": 1, "maxLength": 96 },
              "value": { "type": "integer", "minimum": 0 },
              "drill_down": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "detail": { "type": "string", "maxLength": 4096 }
            }
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "nodes", "edges", "source_digest", "derived", "grants_authority"],
      "properties": {
        "schema": { "const": "zekam-derived-graph/v1" },
        "source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "derived": { "const": true },
        "grants_authority": { "const": false },
        "nodes": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "kind", "label", "canonical_ref"],
            "properties": {
              "node_id": { "type": "string", "minLength": 1, "maxLength": 512 },
              "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
              "label": { "type": "string", "minLength": 1, "maxLength": 160 },
              "canonical_ref": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target", "kind"],
            "properties": {
              "source": { "type": "string", "minLength": 1, "maxLength": 512 },
              "target": { "type": "string", "minLength": 1, "maxLength": 512 },
              "kind": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id", "label", "client", "state", "canonical_ref",
          "job_id", "work_item_id", "step_id", "heartbeat_at", "lease_expires_at",
          "task_label", "model_ref", "current_tool", "active_tool", "parent_agent_id",
          "started_at", "session_id", "process_id", "binding_confidence", "availability",
          "current_action", "process_status", "cpu_percent", "rss_bytes"
          , "project_id"
        ],
        "properties": {
          "agent_id": { "type": "string", "minLength": 1, "maxLength": 512 },
          "label": { "type": "string", "minLength": 1, "maxLength": 128 },
          "client": { "enum": ["zekam", "opencode", "codex", "claude"] },
          "state": { "type": "string", "minLength": 1, "maxLength": 64 },
          "canonical_ref": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "job_id": { "type": ["string", "null"] },
          "work_item_id": { "type": ["string", "null"] },
          "step_id": { "type": ["string", "null"] },
          "heartbeat_at": { "type": ["string", "null"], "format": "date-time" },
          "lease_expires_at": { "type": ["string", "null"], "format": "date-time" },
          "task_label": { "type": ["string", "null"], "maxLength": 128 },
          "model_ref": { "type": ["string", "null"], "maxLength": 256 },
          "current_tool": { "type": ["string", "null"], "maxLength": 48 },
          "active_tool": { "type": ["string", "null"], "maxLength": 48 },
          "parent_agent_id": { "type": ["string", "null"], "maxLength": 512 },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "session_id": { "type": ["string", "null"], "maxLength": 256 },
          "process_id": { "type": ["string", "null"], "maxLength": 128 },
          "binding_confidence": { "enum": ["exact", "strong", "heuristic", "unbound"] },
          "availability": { "enum": ["live", "waiting", "stale", "unbound"] },
          "current_action": { "enum": ["unknown", "planning", "executing", "tool", "waiting"] },
          "process_status": { "type": ["string", "null"], "maxLength": 32 },
          "cpu_percent": { "type": ["number", "null"], "minimum": 0 },
          "rss_bytes": { "type": ["integer", "null"], "minimum": 0 }
          , "project_id": { "type": ["string", "null"] }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "event_type", "source", "occurred_at", "canonical_ref", "job_id", "agent_id"],
        "properties": {
          "event_id": { "type": "string", "minLength": 1, "maxLength": 512 },
          "event_type": { "type": "string", "minLength": 1, "maxLength": 128 },
          "source": { "type": "string", "minLength": 1, "maxLength": 64 },
          "occurred_at": { "type": "string", "format": "date-time" },
          "canonical_ref": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "job_id": { "type": ["string", "null"] },
          "agent_id": { "type": ["string", "null"] }
        }
      }
    },
    "reports": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["report_id", "title", "relative_path", "modified_at", "canonical_ref"],
        "properties": {
          "report_id": { "type": "string", "minLength": 1, "maxLength": 512 },
          "title": { "type": "string", "minLength": 1, "maxLength": 128 },
          "relative_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "modified_at": { "type": "string", "format": "date-time" },
          "canonical_ref": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    },
    "causal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "nodes", "edges", "orphans", "source_digest", "available", "detail", "truncated", "derived", "grants_authority"],
      "properties": {
        "schema": { "const": "zekam-causal-projection/v1" },
        "source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "available": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 512 },
        "truncated": { "type": "boolean" },
        "derived": { "const": true },
        "grants_authority": { "const": false },
        "nodes": {
          "type": "array", "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["node_id", "kind", "state", "occurred_at", "canonical_ref", "work_item_id", "job_id"],
            "properties": {
              "node_id": { "type": "string", "minLength": 1, "maxLength": 512 },
              "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
              "state": { "type": "string", "minLength": 1, "maxLength": 64 },
              "occurred_at": { "type": "string", "format": "date-time" },
              "canonical_ref": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "work_item_id": { "type": ["string", "null"] },
              "job_id": { "type": ["string", "null"] }
            }
          }
        },
        "edges": {
          "type": "array", "maxItems": 512,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["source_node_id", "target_node_id", "kind"],
            "properties": {
              "source_node_id": { "type": "string", "minLength": 1, "maxLength": 512 },
              "target_node_id": { "type": "string", "minLength": 1, "maxLength": 512 },
              "kind": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          }
        },
        "orphans": {
          "type": "array", "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["orphan_kind", "severity", "node_id", "canonical_ref", "observed_at", "reason", "work_item_id", "job_id"],
            "properties": {
              "orphan_kind": { "type": "string", "minLength": 1, "maxLength": 128 },
              "severity": { "enum": ["medium", "high", "critical"] },
              "node_id": { "type": "string", "minLength": 1, "maxLength": 512 },
              "canonical_ref": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "observed_at": { "type": "string", "format": "date-time" },
              "reason": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "work_item_id": { "type": ["string", "null"] },
              "job_id": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "canonical_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "entities", "contradictions", "available", "detail", "truncated", "read_only", "grants_authority"],
      "properties": {
        "schema": { "const": "zekam-canonical-runtime-projection/v1" },
        "available": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 512 },
        "truncated": { "type": "boolean" },
        "read_only": { "const": true },
        "grants_authority": { "const": false },
        "entities": {
          "type": "array", "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["entity_id", "kind", "state", "canonical_ref", "occurred_at", "parent_id", "work_item_id", "job_id", "terminal_receipt_bound", "project_id"],
            "properties": {
              "entity_id": { "type": "string", "minLength": 1, "maxLength": 512 },
              "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
              "state": { "type": "string", "minLength": 1, "maxLength": 64 },
              "canonical_ref": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "occurred_at": { "type": "string", "format": "date-time" },
              "parent_id": { "type": ["string", "null"], "maxLength": 512 },
              "work_item_id": { "type": ["string", "null"] },
              "job_id": { "type": ["string", "null"] },
              "terminal_receipt_bound": { "type": "boolean" },
              "project_id": { "type": ["string", "null"] }
            }
          }
        },
        "contradictions": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["contradiction_id", "kind", "severity", "state", "canonical_ref", "observed_at", "work_item_id", "job_id"],
            "properties": {
              "contradiction_id": { "type": "string", "minLength": 1, "maxLength": 512 },
              "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
              "severity": { "enum": ["medium", "high", "critical"] },
              "state": { "type": "string", "minLength": 1, "maxLength": 64 },
              "canonical_ref": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "observed_at": { "type": "string", "format": "date-time" },
              "work_item_id": { "type": ["string", "null"] },
              "job_id": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "detail"],
      "properties": {
        "available": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_content", "model_response_content", "secret_values", "authority"],
      "properties": {
        "prompt_content": { "const": false },
        "model_response_content": { "const": false },
        "secret_values": { "const": false },
        "authority": { "const": false }
      }
    }
  }
}
