{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zekam Effect Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "project_id",
    "work_item_id",
    "plan_revision_id",
    "step_id",
    "operation",
    "effect_digest",
    "logical_resources",
    "authorization_digest",
    "execution_identity",
    "job_id",
    "attempt_id",
    "fencing_token",
    "host_digest",
    "idempotency_key",
    "claimed_at",
    "claim_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "claim_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "work_item_id": {
      "$ref": "#/$defs/id"
    },
    "plan_revision_id": {
      "$ref": "#/$defs/id"
    },
    "step_id": {
      "$ref": "#/$defs/id"
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "effect_digest": {
      "$ref": "#/$defs/digest"
    },
    "logical_resources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/logicalResource"
      }
    },
    "authorization_digest": {
      "$ref": "#/$defs/digest"
    },
    "execution_identity": {
      "$ref": "#/$defs/id"
    },
    "job_id": {
      "$ref": "#/$defs/id"
    },
    "attempt_id": {
      "$ref": "#/$defs/id"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "host_digest": {
      "$ref": "#/$defs/digest"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "claimed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "claim_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "logicalResource": {
      "type": "string",
      "pattern": "^[a-z0-9-]+:[^\\s]+$",
      "maxLength": 500
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
      "maxLength": 1000
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "work",
            "run",
            "receipt",
            "test",
            "artifact",
            "source",
            "citation",
            "memory",
            "benchmark",
            "commit"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}