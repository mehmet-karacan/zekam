{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zekam.local/schemas/execution-topology-decision.schema.json",
  "title": "Zekam ExecutionTopologyDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pattern", "objective_digest", "plan_digest", "node_modes", "parallelism_ceiling", "estimated_calls", "estimated_tokens", "estimated_cost_micros", "estimated_coordination_overhead_micros", "required_human_gates", "reason_codes", "grants_authority", "decision_digest"],
  "properties": {
    "schema": {"const": "zekam-execution-topology-decision/v1"},
    "pattern": {"enum": ["direct", "single-pass", "bounded-loop", "tournament", "graph", "queue-human-review", "blocked"]},
    "objective_digest": {"$ref": "#/$defs/digest"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "node_modes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["step_id", "mode"], "properties": {"step_id": {"type": "string", "minLength": 1}, "mode": {"enum": ["direct", "bounded-loop", "tournament", "human-gate"]}}}},
    "parallelism_ceiling": {"type": "integer", "minimum": 0},
    "estimated_calls": {"type": "integer", "minimum": 0},
    "estimated_tokens": {"type": "integer", "minimum": 0},
    "estimated_cost_micros": {"type": "integer", "minimum": 0},
    "estimated_coordination_overhead_micros": {"type": "integer", "minimum": 0},
    "required_human_gates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "grants_authority": {"const": false},
    "decision_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
