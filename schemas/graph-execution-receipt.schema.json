{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zekam.local/schemas/graph-execution-receipt.schema.json",
  "title": "Zekam GraphExecutionReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "graph_root_id", "plan_digest", "node_receipts", "critical_path", "max_observed_concurrency", "parallel_overlap_duration_millis", "parallel_efficiency_ppm", "coordination_input_tokens", "coordination_output_tokens", "coordination_cost_micros", "coordination_message_count", "fan_in_result_digest", "terminal_state", "topology_feedback", "grants_authority", "receipt_digest"],
  "properties": {
    "schema": {"const": "zekam-graph-execution-receipt/v1"},
    "graph_root_id": {"type": "string", "format": "uuid"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "node_receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node_receipt"}},
    "critical_path": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "max_observed_concurrency": {"type": "integer", "minimum": 0},
    "parallel_overlap_duration_millis": {"type": "integer", "minimum": 0},
    "parallel_efficiency_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "coordination_input_tokens": {"type": "integer", "minimum": 0},
    "coordination_output_tokens": {"type": "integer", "minimum": 0},
    "coordination_cost_micros": {"type": "integer", "minimum": 0},
    "coordination_message_count": {"type": "integer", "minimum": 0},
    "fan_in_result_digest": {"$ref": "#/$defs/digest"},
    "terminal_state": {"enum": ["completed", "failed", "recovery-required"]},
    "topology_feedback": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "grants_authority": {"const": false},
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "node_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "mode", "queued_at", "started_at", "ended_at", "dependency_wait_millis", "resource_wait_millis", "coordination_input_tokens", "coordination_output_tokens", "coordination_cost_micros", "coordination_message_count", "result_digest", "terminal_state"],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["direct", "bounded-loop", "tournament", "human-gate"]},
        "queued_at": {"type": "string", "format": "date-time"},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "dependency_wait_millis": {"type": "integer", "minimum": 0},
        "resource_wait_millis": {"type": "integer", "minimum": 0},
        "coordination_input_tokens": {"type": "integer", "minimum": 0},
        "coordination_output_tokens": {"type": "integer", "minimum": 0},
        "coordination_cost_micros": {"type": "integer", "minimum": 0},
        "coordination_message_count": {"type": "integer", "minimum": 0},
        "result_digest": {"$ref": "#/$defs/digest"},
        "terminal_state": {"enum": ["completed", "failed", "cancelled", "recovery-required"]}
      }
    }
  }
}
