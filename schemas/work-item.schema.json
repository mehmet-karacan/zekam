{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zekam Work Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_item_id",
    "project_id",
    "type",
    "state",
    "title",
    "revision",
    "intent_ref",
    "acceptance_criteria",
    "relations",
    "created_at",
    "updated_at",
    "record_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "work_item_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "external_number": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "type": {
      "enum": [
        "request",
        "defect",
        "task",
        "subtask",
        "decision",
        "research",
        "idea",
        "maintenance"
      ]
    },
    "state": {
      "enum": [
        "proposed",
        "ready",
        "active",
        "blocked",
        "verification",
        "completed",
        "cancelled",
        "archived"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "summary": {
      "type": "string",
      "maxLength": 5000
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "intent_ref": {
      "$ref": "#/$defs/id"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "target_work_item_id"
        ],
        "properties": {
          "kind": {
            "enum": [
              "depends-on",
              "blocks",
              "parent-of",
              "relates-to",
              "duplicates",
              "supersedes"
            ]
          },
          "target_work_item_id": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "record_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "logicalResource": {
      "type": "string",
      "pattern": "^[a-z0-9-]+:[^\\s]+$",
      "maxLength": 500
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
      "maxLength": 1000
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "work",
            "run",
            "receipt",
            "test",
            "artifact",
            "source",
            "citation",
            "memory",
            "benchmark",
            "commit"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}