{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zekam.local/schemas/loop-progress-packet.schema.json",
  "title": "Zekam LoopProgressPacket",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "objective_digest", "source_revision", "plan_digest", "policy_revision_digest", "validator_asset_manifest_digest", "artifact_before_digest", "artifact_after_digest", "predecessor_attempt_id", "attempt_ordinal", "previous_metric_vector", "current_metric_vector", "metric_deltas", "accepted_hypothesis_digest", "rejected_hypothesis_digests", "patch_digest", "failure_signature", "validator_diagnosis", "new_evidence_refs", "remaining_budget", "next_allowed_focus", "forbidden_retries", "max_packet_tokens", "grants_authority"],
  "properties": {
    "schema": {"const": "zekam-loop-progress-packet/v1"},
    "objective_digest": {"$ref": "#/$defs/digest"},
    "source_revision": {"type": "string", "minLength": 1},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "policy_revision_digest": {"$ref": "#/$defs/digest"},
    "validator_asset_manifest_digest": {"$ref": "#/$defs/digest"},
    "artifact_before_digest": {"$ref": "#/$defs/digest"},
    "artifact_after_digest": {"$ref": "#/$defs/digest"},
    "predecessor_attempt_id": {"type": "string", "format": "uuid"},
    "attempt_ordinal": {"type": "integer", "minimum": 2},
    "previous_metric_vector": {"$ref": "progress-vector.schema.json"},
    "current_metric_vector": {"$ref": "progress-vector.schema.json"},
    "metric_deltas": {"type": "object", "additionalProperties": {"type": "number"}},
    "accepted_hypothesis_digest": {"$ref": "#/$defs/digest"},
    "rejected_hypothesis_digests": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "patch_digest": {"$ref": "#/$defs/digest"},
    "failure_signature": {"$ref": "#/$defs/digest"},
    "validator_diagnosis": {"type": "object", "additionalProperties": false, "required": ["ref", "digest"], "properties": {"ref": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "new_evidence_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["ref", "digest"], "properties": {"ref": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}}},
    "remaining_budget": {"type": "object", "additionalProperties": false, "required": ["attempts", "tokens", "cost_micros", "time_seconds"], "properties": {"attempts": {"type": "integer", "minimum": 0}, "tokens": {"type": "integer", "minimum": 0}, "cost_micros": {"type": "integer", "minimum": 0}, "time_seconds": {"type": "integer", "minimum": 0}}},
    "next_allowed_focus": {"type": "string", "minLength": 1},
    "forbidden_retries": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "max_packet_tokens": {"type": "integer", "minimum": 1},
    "grants_authority": {"const": false}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
