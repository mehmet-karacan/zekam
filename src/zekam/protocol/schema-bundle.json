      "additionalProperties": true,
      "properties": {
        "category": {
          "enum": [
            "parse-error",
            "invalid-request",
            "method-not-found",
            "not-initialized",
            "already-initialized",
            "schema-mismatch",
            "overloaded",
            "policy-denied",
            "experimental-not-enabled",
            "cursor-expired"
          ],
          "title": "Category",
          "type": "string"
        },
        "grants_authority": {
          "const": false,
          "title": "Grants Authority",
          "type": "boolean"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "category",
        "retryable",
        "grants_authority"
      ],
      "title": "ProtocolErrorData",
      "type": "object"
    },
    "ProtocolNotification": {
      "anyOf": [
        {
          "$ref": "#/$defs/InitializedNotification"
        },
        {
          "$ref": "#/$defs/ServerNotification"
        },
        {
          "$ref": "#/$defs/FutureNotification"
        }
