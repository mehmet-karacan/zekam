    "ReplayParams": {
      "additionalProperties": false,
      "properties": {
        "after_sequence": {
          "minimum": 0,
          "title": "After Sequence",
          "type": "integer"
        },
        "limit": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
