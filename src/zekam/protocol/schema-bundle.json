{
  "$defs": {
    "AppNotificationPayload": {
      "additionalProperties": false,
      "properties": {
        "event_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Event Digest",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "pattern": "^[a-z][a-z0-9_.\\-/]{0,127}$",
          "title": "Event Type",
          "type": "string"
        },
        "grants_authority": {
          "const": false,
          "title": "Grants Authority",
          "type": "boolean"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "previous_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Digest"
        },
        "schema": {
          "const": "zekam-app-notification/v1",
          "title": "Schema",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "schema",
        "event_id",
        "sequence",
        "previous_digest",
        "event_type",
        "payload",
        "occurred_at",
        "grants_authority",
        "event_digest"
      ],
      "title": "AppNotificationPayload",
      "type": "object"
    },
    "EmptyParams": {
      "additionalProperties": false,
      "properties": {},
      "title": "EmptyParams",
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/ProtocolError"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonRpcId"
            },
            {
              "type": "null"
            }
          ]
        },
        "jsonrpc": {
          "const": "2.0",
          "title": "Jsonrpc",
          "type": "string"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "ForkPrepareRequest": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/JsonRpcId"
        },
        "jsonrpc": {
          "const": "2.0",
          "title": "Jsonrpc",
          "type": "string"
        },
        "method": {
          "const": "experimental/session-fork.prepare",
          "title": "Method",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/EmptyParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "title": "ForkPrepareRequest",
      "type": "object"
    },
    "ForkPrepareResult": {
      "additionalProperties": false,
      "properties": {
        "carries_authority": {
          "const": false,
          "title": "Carries Authority",
          "type": "boolean"
        },
        "carries_lease": {
          "const": false,
          "title": "Carries Lease",
          "type": "boolean"
        },
        "carries_receipt": {
          "const": false,
          "title": "Carries Receipt",
          "type": "boolean"
        },
        "disposition": {
          "const": "prepare-only",
          "title": "Disposition",
          "type": "string"
        },
        "grants_authority": {
          "const": false,
          "title": "Grants Authority",
          "type": "boolean"
        },
        "read_only": {
          "const": true,
          "title": "Read Only",
          "type": "boolean"
        },
        "schema": {
          "const": "zekam-session-fork-prepare/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "disposition",
        "carries_authority",
        "carries_lease",
        "carries_receipt",
        "read_only",
        "grants_authority"
      ],
      "title": "ForkPrepareResult",
      "type": "object"
    },
    "FutureNotification": {
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0",
          "title": "Jsonrpc",
          "type": "string"
        },
        "method": {
          "not": {
            "enum": [
              "initialized",
              "server/notification"
            ]
          },
          "pattern": "^[a-z][a-z0-9_.\\-/]{0,127}$",
          "title": "Method",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "title": "FutureNotification",
      "type": "object"
    },
    "InitializeParams": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.\\-/]{0,127}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "client_id": {
          "pattern": "^[A-Za-z0-9_.-]{1,80}$",
          "title": "Client Id",
          "type": "string"
        },
        "client_version": {
          "pattern": "^[A-Za-z0-9_.-]{1,80}$",
          "title": "Client Version",
          "type": "string"
        },
        "experimental_methods": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.\\-/]{0,127}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Experimental Methods",
          "type": "array",
          "uniqueItems": true
        },
        "protocol_version": {
          "const": "1.0",
          "title": "Protocol Version",
          "type": "string"
        },
        "replay_cursor": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Replay Cursor"
        },
        "schema_bundle_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Schema Bundle Digest",
          "type": "string"
        }
      },
      "required": [
        "client_id",
        "client_version",
        "protocol_version",
        "schema_bundle_digest",
        "capabilities",
        "experimental_methods",
        "replay_cursor"
      ],
      "title": "InitializeParams",
      "type": "object"
    },
    "InitializeRequest": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/JsonRpcId"
        },
        "jsonrpc": {
          "const": "2.0",
          "title": "Jsonrpc",
          "type": "string"
        },
        "method": {
          "const": "initialize",
          "title": "Method",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/InitializeParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "title": "InitializeRequest",
      "type": "object"
    },
    "InitializeResult": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "connection_id": {
          "format": "uuid",
          "title": "Connection Id",
          "type": "string"
        },
        "experimental_methods": {
          "items": {
            "type": "string"
          },
          "title": "Experimental Methods",
          "type": "array"
        },
        "grants_authority": {
          "const": false,
          "title": "Grants Authority",
          "type": "boolean"
        },
        "ingress_limit": {
          "title": "Ingress Limit",
          "type": "integer"
        },
        "max_frame_bytes": {
          "title": "Max Frame Bytes",
          "type": "integer"
        },
        "outbound_limit": {
          "title": "Outbound Limit",
          "type": "integer"
        },
        "protocol_version": {
          "const": "1.0",
          "title": "Protocol Version",
          "type": "string"
        },
        "read_only": {
          "const": true,
          "title": "Read Only",
          "type": "boolean"
        },
        "replay_limit": {
          "title": "Replay Limit",
          "type": "integer"
        },
        "schema": {
          "const": "zekam-app-server-protocol/v1",
          "title": "Schema",
          "type": "string"
        },
        "schema_bundle_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Schema Bundle Digest",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "connection_id",
        "protocol_version",
        "schema_bundle_digest",
        "capabilities",
        "experimental_methods",
        "ingress_limit",
        "outbound_limit",
        "replay_limit",
        "max_frame_bytes",
        "read_only",
        "grants_authority"
      ],
      "title": "InitializeResult",
      "type": "object"
